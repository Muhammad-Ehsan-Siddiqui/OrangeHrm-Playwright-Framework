{
  "name": "orangehrm-playwright",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:login": "playwright test tests/login.spec.ts",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:report": "playwright show-report",
    "test:allure": "allure run -- playwright test",
    "test:dev": "cross-env ENV=dev playwright test",
    "test:qa": "cross-env ENV=qa playwright test",
    "test:staging": "cross-env ENV=staging playwright test",
    "allure:generate": "allure generate reports/allure-results --output reports/allure-report",
    "allure:open": "allure open reports/allure-report"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "allure": "^3.19.1",
    "allure-playwright": "^3.13.0",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.5",
    "typescript": "^5.7.0"
  }
}
